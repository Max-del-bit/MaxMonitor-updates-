# ---------------------------------------------------------
# HELPER FUNCTIONS
# ---------------------------------------------------------
def is_admin():
    """Prüft, ob Administrator-Rechte vorliegen."""
    try:
        return ctypes.windll.shell32.IsUserAnAdmin() != 0
    except Exception:
        return False

def run_as_admin():
    """Startet die App mit Windows UAC Admin-Rechten neu."""
    if is_admin():
        return
    try:
        if getattr(sys, 'frozen', False):
            executable = sys.executable
            ctypes.windll.shell32.ShellExecuteW(None, "runas", executable, "", None, 1)
        else:
            executable = sys.executable
            args = f'"{os.path.abspath(__file__)}"'
            ctypes.windll.shell32.ShellExecuteW(None, "runas", executable, args, None, 1)
        sys.exit(0)
    except Exception as e:
        messagebox.showerror("UAC Fehler", f"Konnte Admin-Rechte nicht anfordern: {e}")

def get_app_dir():
    """Liefert das Verzeichnis der App zurück."""
    if getattr(sys, 'frozen', False):
        return os.path.dirname(sys.executable)
    return os.path.dirname(os.path.abspath(__file__))

def run_hidden(args, timeout=10):
    """Führt Subprozesse unsichtbar im Hintergrund aus."""
    no_window = 0x08000000 if sys.platform == "win32" else 0
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout, creationflags=no_window, encoding="oem", errors="replace")
    except Exception as e:
        return None


# ---------------------------------------------------------
# HARDWARE MONITORING CLASS (PDH & WMI)
# ---------------------------------------------------------
class HardwareMonitor:
    def __init__(self):
        self.gpu_query = None
        self.gpu_counter = None
        self._init_gpu_counter()
        self.wmi_obj = None
        if wmi:
            try:
                import pythoncom
                pythoncom.CoInitialize()
                self.wmi_obj = wmi.WMI(namespace="root\\wmi")
            except Exception:
                self.wmi_obj = None

    def _init_gpu_counter(self):
        """Initialisiert Windows Performance Counter für Vega 8 iGPU."""
        try:
            import win32pdh
            self.pdh = win32pdh
            self.gpu_query = self.pdh.OpenQuery()
            path = self.pdh.MakeCounterPath((None, "GPU Engine", "*", None, -1, "Utilization Percentage"))
            self.gpu_counter = self.pdh.AddCounter(self.gpu_query, path)
            self.pdh.CollectQueryData(self.gpu_query)
        except Exception:
            self.gpu_query = None
            self.gpu_counter = None

    def get_gpu_usage(self):
        if not self.gpu_query or not self.gpu_counter:
            return 0.0
        try:
            self.pdh.CollectQueryData(self.gpu_query)
            _, val = self.pdh.GetFormattedCounterValue(self.gpu_counter, self.pdh.PDH_FMT_DOUBLE)
            return round(val, 1)
        except Exception:
            return 0.0

    def get_cpu_temp(self):
        if not self.wmi_obj:
            return "N/A"
        try:
            temperature_info = self.wmi_obj.MSAcpi_ThermalZoneTemperature()
            if temperature_info:
                temp_k = temperature_info[0].CurrentTemperature
                temp_c = (temp_k / 10.0) - 273.15
                if 0 <= temp_c <= 120:
                    return f"{round(temp_c, 1)} °C"
        except Exception:
            pass
        return "N/A"


