    # ---------------------------------------------------------
    # TAB 3: PROCESS LASSO / PROBALANCE
    # ---------------------------------------------------------
    def _build_tab_procs(self):
        container = ttk.LabelFrame(self.tab_procs, text="⚙️ Process Lasso & ProBalance (Prozess-Manager)")
        container.pack(fill="both", expand=True, padx=20, pady=20)

        top_bar = ttk.Frame(container, style="Card.TFrame")
        top_bar.pack(fill="x", padx=15, pady=10)

        ttk.Button(top_bar, text="🔄 Prozesse Aktualisieren", command=self.refresh_process_list).pack(side="left", padx=5)
        ttk.Button(top_bar, text="🛑 Prozess Beenden (Kill)", style="Danger.TButton", command=self.kill_selected_process).pack(side="left", padx=5)
        ttk.Button(top_bar, text="⚡ Priorität auf 'Hoch'", style="Primary.TButton", command=lambda: self.set_process_priority(psutil.HIGH_PRIORITY_CLASS)).pack(side="left", padx=5)

        # Treeview for Processes
        cols = ("name", "pid", "cpu", "ram")
        self.tree_procs = ttk.Treeview(container, columns=cols, show="headings", height=15)
        self.tree_procs.heading("name", text="Prozessname")
        self.tree_procs.heading("pid", text="PID")
        self.tree_procs.heading("cpu", text="CPU (%)")
        self.tree_procs.heading("ram", text="RAM (MB)")
        self.tree_procs.column("name", width=250)
        self.tree_procs.column("pid", width=100)
        self.tree_procs.column("cpu", width=100)
        self.tree_procs.column("ram", width=100)
        self.tree_procs.pack(fill="both", expand=True, padx=15, pady=10)

        self.refresh_process_list()

    def refresh_process_list(self):
        for item in self.tree_procs.get_children():
            self.tree_procs.delete(item)
        try:
            for p in psutil.process_iter(['pid', 'name', 'cpu_percent', 'memory_info']):
                try:
                    info = p.info
                    pid = info['pid']
                    name = info['name'] or "?"
                    cpu = info['cpu_percent'] or 0.0
                    ram = round((info['memory_info'].rss / (1024**2)), 1) if info['memory_info'] else 0.0
                    self.tree_procs.insert("", "end", values=(name, pid, f"{cpu}%", f"{ram} MB"))
                except Exception:
                    pass
        except Exception:
            pass

    def kill_selected_process(self):
        sel = self.tree_procs.selection()
        if not sel:
            messagebox.showwarning("Auswahl fehlt", "Bitte wähle einen Prozess aus!")
            return
        vals = self.tree_procs.item(sel[0], "values")
        pid = int(vals[1])
        name = vals[0]
        if messagebox.askyesno("Prozess beenden", f"Möchtest du '{name}' (PID {pid}) wirklich beenden?"):
            try:
                psutil.Process(pid).terminate()
                self.log(f"✅ Prozess {name} (PID {pid}) beendet.")
                self.refresh_process_list()
            except Exception as e:
                messagebox.showerror("Fehler", f"Konnte Prozess nicht beenden: {e}")

    def set_process_priority(self, priority):
        sel = self.tree_procs.selection()
        if not sel:
            messagebox.showwarning("Auswahl fehlt", "Bitte wähle einen Prozess aus!")
            return
        vals = self.tree_procs.item(sel[0], "values")
        pid = int(vals[1])
        name = vals[0]
        try:
            psutil.Process(pid).nice(priority)
            self.log(f"⚡ Priorität für {name} geändert.")
        except Exception as e:
            messagebox.showerror("Fehler", f"Fehler beim Ändern der Priorität: {e}")

    # ---------------------------------------------------------
    # TAB 4: DEEP UNINSTALLER (Rückstandslose Deinstallation)
    # ---------------------------------------------------------
    def _build_tab_uninst(self):
        container = ttk.LabelFrame(self.tab_uninst, text="🧹 Der ultimative Deep Uninstaller (Rückstandslose Löschung)")
        container.pack(fill="both", expand=True, padx=20, pady=20)

        ttk.Label(container, text="Gib den Namen einer App oder eines Spiels ein. Der Uninstaller durchsucht Ordner & Registry nach Überresten!", style="Card.TLabel").pack(anchor="w", padx=15, pady=10)

        search_box = ttk.Frame(container, style="Card.TFrame")
        search_box.pack(fill="x", padx=15, pady=5)

        self.e_uninst = ttk.Entry(search_box, width=40, font=("Segoe UI", 11))
        self.e_uninst.pack(side="left", padx=(0, 10))

        ttk.Button(search_box, text="🔍 Tiefen-Suche starten", style="Primary.TButton", command=self.run_deep_search).pack(side="left")

        self.txt_uninst = scrolledtext.ScrolledText(
            container, height=12, bg=COLOR_BG, fg=COLOR_TEXT,
            insertbackground="white", font=("Consolas", 9), borderwidth=0, highlightthickness=0
        )
        self.txt_uninst.pack(fill="both", expand=True, padx=15, pady=10)

        ttk.Button(container, text="🗑️ ALLE GEFUNDENEN RÜCKSTÄNDE LÖSCHEN", style="Danger.TButton", command=self.execute_deep_uninstall).pack(anchor="e", padx=15, pady=(0, 10))
        self.found_uninstall_paths = []

    def run_deep_search(self):
        query = self.e_uninst.get().strip().lower()
        if not query:
            messagebox.showwarning("Eingabe fehlt", "Bitte gib einen Suchbegriff ein!")
            return

        self.txt_uninst.delete("1.0", tk.END)
        self.txt_uninst.insert(tk.END, f"🔍 Starte Deep-Suche nach '{query}' in Ordnern und Registry...\n\n")
        self.found_uninstall_paths = []

        def worker():
            search_dirs = [
                os.environ.get("LOCALAPPDATA", ""),
                os.environ.get("APPDATA", ""),
                os.environ.get("ProgramFiles", ""),
                os.environ.get("ProgramFiles(x86)", "")
            ]
            for base in search_dirs:
                if not base or not os.path.exists(base):
                    continue
                try:
                    for d in os.listdir(base):
                        if query in d.lower():
                            full_p = os.path.join(base, d)
                            self.found_uninstall_paths.append(full_p)
                            self.queue.put(("UNINST_LOG", f"📁 Gefundener Ordner: {full_p}\n"))
                except Exception:
                    pass

            # Registry Uninstall Check
            reg_paths = [
                r"SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall",
                r"SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall"
            ]
            for root in (winreg.HKEY_CURRENT_USER, winreg.HKEY_LOCAL_MACHINE):
                for p in reg_paths:
                    try:
                        with winreg.OpenKey(root, p) as key:
                            for i in range(winreg.QueryInfoKey(key)[0]):
                                subkey_name = winreg.EnumKey(key, i)
                                with winreg.OpenKey(key, subkey_name) as subkey:
                                    try:
                                        display_name, _ = winreg.QueryValueEx(subkey, "DisplayName")
                                        if query in display_name.lower():
                                            self.queue.put(("UNINST_LOG", f"🔑 Registry-Eintrag: {display_name} ({p}\\{subkey_name})\n"))
                                    except Exception:
                                        pass
                    except Exception:
                        pass
            self.queue.put(("UNINST_LOG", "\n✅ Deep-Suche abgeschlossen! Klicke auf 'Löschen' zum Entfernen.\n"))

        threading.Thread(target=worker, daemon=True).start()

    def execute_deep_uninstall(self):
        if not self.found_uninstall_paths:
            messagebox.showwarning("Keine Daten", "Es wurden keine Ordner zum Löschen gefunden.")
            return

        if messagebox.askyesno("Sicherheitsfrage", "Möchtest du alle gefundenen Ordner und Überreste unwiderruflich löschen?"):
            for path in self.found_uninstall_paths:
                try:
                    if os.path.isdir(path):
                        shutil.rmtree(path)
                        self.log(f"🗑️ Gelöscht: {path}")
                except Exception as e:
                    self.log(f"❌ Fehler beim Löschen von {path}: {e}")
            messagebox.showinfo("Erfolg", "Ausgewählte Ordner wurden rückstandslos gelöscht!")

    # ---------------------------------------------------------
    # TAB 5: SYSTEM & TOOLS
    # ---------------------------------------------------------
    def _build_tab_tools(self):
        container = ttk.LabelFrame(self.tab_tools, text="🛠️ System-Diagnose, SFC & Gaming Booster")
        container.pack(fill="both", expand=True, padx=20, pady=20)

        ttk.Button(container, text="⚡ Gaming-Booster aktivieren (Höchstleistung + Core Parking aus)", style="Primary.TButton", command=self.activate_gaming_booster).pack(anchor="w", padx=15, pady=10)
        ttk.Button(container, text="🔍 SFC System-Scan ausführen (sfc /scannow)", command=self.run_sfc_scan).pack(anchor="w", padx=15, pady=5)
        ttk.Button(container, text="🌐 DNS-Cache leeren (ipconfig /flushdns)", command=self.flush_dns).pack(anchor="w", padx=15, pady=5)

    # ---------------------------------------------------------
    # BUSINESS LOGIC & THREADS
    # ---------------------------------------------------------
    def log(self, text):
        self.txt_console.insert(tk.END, f"[{time.strftime('%H:%M:%S')}] {text}\n")
        self.txt_console.see(tk.END)

    def _check_queue(self):
        try:
            while True:
                msg_type, payload = self.queue.get_nowait()
                if msg_type == "LOG":
                    self.log(payload)
                elif msg_type == "GPU_VAL":
                    self.lbl_gpu.config(text=f"{payload} %")
                    self.pb_gpu["value"] = payload
                elif msg_type == "TEMP_VAL":
                    self.lbl_temp.config(text=f"Temperatur: {payload}")
                elif msg_type == "UNINST_LOG":
                    self.txt_uninst.insert(tk.END, payload)
                    self.txt_uninst.see(tk.END)
        except queue.Empty:
            pass
        self.after(200, self._check_queue)

    def _start_background_threads(self):
        def monitor_loop():
            while True:
                try:
                    cpu = psutil.cpu_percent(interval=None)
                    ram = psutil.virtual_memory()
                    ram_used = round(ram.used / (1024**3), 1)
                    ram_total = round(ram.total / (1024**3), 1)
                    ram_p = ram.percent

                    self.after(0, lambda: self._update_dash(cpu, ram_p, ram_used, ram_total))

                    gpu = self.monitor.get_gpu_usage()
                    self.queue.put(("GPU_VAL", gpu))

                    temp = self.monitor.get_cpu_temp()
                    self.queue.put(("TEMP_VAL", temp))
                except Exception:
                    pass
                time.sleep(1.5)

        threading.Thread(target=monitor_loop, daemon=True).start()

    def _update_dash(self, cpu, ram_p, ram_used, ram_total):
        self.lbl_cpu.config(text=f"{cpu} %")
        self.pb_cpu["value"] = cpu
        self.lbl_ram.config(text=f"{ram_used} GB / {ram_total} GB ({ram_p}%)")
        self.pb_ram["value"] = ram_p

    def clean_ram(self):
        def worker():
            self.log("Starte RAM-Bereinigung...")
            try:
                ctypes.windll.psapi.EmptyWorkingSet(ctypes.windll.kernel32.GetCurrentProcess())
                self.log("✅ RAM erfolgreich bereinigt!")
            except Exception as e:
                self.log(f"❌ Fehler bei RAM-Bereinigung: {e}")
        threading.Thread(target=worker, daemon=True).start()

    def apply_ryzen_adj(self):
        if not is_admin():
            messagebox.showwarning("Admin erforderlich", "RyzenAdj benötigt Administrator-Rechte.")
            return

        stapm = int(self.sl_stapm.get()) * 1000
        slow = int(self.sl_slow.get()) * 1000
        temp = int(self.sl_temp.get())

        ryzen_exe = os.path.join(get_app_dir(), "ryzenadj.exe")
        if not os.path.exists(ryzen_exe):
            messagebox.showerror("Fehlt", f"ryzenadj.exe nicht in {get_app_dir()} gefunden!")
            return

        def worker():
            cmd = f'"{ryzen_exe}" --stapm-limit={stapm} --fast-limit={slow} --tctl-temp={temp}'
            self.log(f"Führe RyzenAdj aus: {cmd}")
            res = run_hidden(cmd)
            if res and res.returncode == 0:
                self.log("✅ UXTU Boost Limits erfolgreich angewendet!")
            else:
                self.log("⚠️ RyzenAdj angewendet (oder Limit erreicht).")
        threading.Thread(target=worker, daemon=True).start()

    def activate_gaming_booster(self):
        def worker():
            self.log("Aktiviere Gaming Booster...")
            try:
                subprocess.run("powercfg /setactive 8c5e7fda-e8bf-4a96-9a15-a942f6d61d4e", shell=True)
                if is_admin():
                    subprocess.run("powercfg -setacvalueindex scheme_current sub_processor CPMINCORES 100", shell=True)
                    subprocess.run("powercfg -setactive scheme_current", shell=True)
                self.log("🚀 Gaming-Booster erfolgreich aktiviert!")
            except Exception as e:
                self.log(f"❌ Fehler beim Booster: {e}")
        threading.Thread(target=worker, daemon=True).start()

    def run_sfc_scan(self):
        if not is_admin():
            messagebox.showwarning("Admin erforderlich", "SFC Scan benötigt Administrator-Rechte.")
            return
        def worker():
            self.log("Starte SFC System-Scan (sfc /scannow)...")
            res = run_hidden("sfc /scannow", timeout=300)
            if res:
                self.log(f"SFC Ergebnis:\n{res.stdout}")
        threading.Thread(target=worker, daemon=True).start()

    def flush_dns(self):
        def worker():
            run_hidden("ipconfig /flushdns")
            self.log("🌐 DNS-Cache erfolgreich geleert!")
        threading.Thread(target=worker, daemon=True).start()

    # ---------------------------------------------------------
    # GITHUB AUTO-UPDATER
    # ---------------------------------------------------------
    def check_for_updates(self):
        def worker():
            self.log("Suche nach Updates auf GitHub...")
            try:
                url = f"https://api.github.com/repos/{GITHUB_REPO}/releases/latest"
                req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
                with urllib.request.urlopen(req, timeout=10) as resp:
                    data = json.loads(resp.read().decode())
                    latest_tag = data.get("tag_name", "")

                    if latest_tag and latest_tag != APP_VERSION:
                        self.log(f"🎉 Neues Update gefunden: {latest_tag} (Aktuell: {APP_VERSION})")
                        download_url = None
                        for asset in data.get("assets", []):
                            if asset["name"].endswith(".exe"):
                                download_url = asset["browser_download_url"]
                                break

                        if download_url:
                            self.queue.put(("LOG", f"Lade Update {latest_tag} herunter..."))
                            self._install_update(download_url)
                        else:
                            self.log("⚠️ Keine .exe im GitHub Release Asset gefunden.")
                    else:
                        self.log("✅ Du verwendest bereits die neueste Version!")
            except Exception as e:
                self.log(f"⚠️ Update-Prüfung fehlgeschlagen: {e}")

        threading.Thread(target=worker, daemon=True).start()

    def _install_update(self, download_url):
        try:
            current_exe = sys.executable if getattr(sys, 'frozen', False) else None
            if not current_exe:
                self.log("⚠️ Auto-Update nur in der kompilierten .exe möglich.")
                return

            new_exe = current_exe + ".new"
            old_exe = current_exe + ".old"

            urllib.request.urlretrieve(download_url, new_exe)

            if os.path.exists(old_exe):
                os.remove(old_exe)
            os.rename(current_exe, old_exe)
            os.rename(new_exe, current_exe)

            subprocess.Popen([current_exe])
            sys.exit(0)
        except Exception as e:
            self.log(f"❌ Fehler bei der Installation des Updates: {e}")

    def _cleanup_old_files(self):
        try:
            if getattr(sys, 'frozen', False):
                old_exe = sys.executable + ".old"
                if os.path.exists(old_exe):
                    os.remove(old_exe)
        except Exception:
            pass


# ---------------------------------------------------------
# ENTRY POINT
# ---------------------------------------------------------
if __name__ == "__main__":
    app = MaxMonitorV2()
    app.mainloop()
